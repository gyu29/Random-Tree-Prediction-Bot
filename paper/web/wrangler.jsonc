// Cloudflare Workers config for the works site (public/index.html, which links the paper's
// PDF). There is no Worker script: Cloudflare serves the files in public/ as static assets.
//
//   npm install          # once, installs Wrangler
//   npx wrangler login   # once, links Wrangler to your Cloudflare account
//   npm run deploy       # rebuilds public/paper.pdf with build.py, then runs wrangler deploy
//
// `npx wrangler deploy` on its own uploads public/ as it is, without rebuilding the PDF.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proud-moon-b1cb",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public"
  }
}
