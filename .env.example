# data.go.kr service key for Korean market data
KRX_SERVICE_KEY=replace_with_your_data_go_kr_service_key

# Optional: only needed if you want to use US market data
ALPHA_VANTAGE_API_KEY=replace_with_your_alpha_vantage_key

# Auto-generated the first time a model is trained and saved. Signs model
# manifests so tampered/corrupted artifacts are detected before loading.
# Leave blank -- do not set this yourself, and never share or commit it.
# MODEL_SIGNING_KEY=
